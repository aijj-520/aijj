{
  "redirects": [
    {
      "source": "/ponder",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ponder.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tools/classroom-worksheets/",
      "destination": "/tools/classroom-worksheets",
      "permanent": true
    },
    {
      "source": "/worksheets/",
      "destination": "/worksheets",
      "permanent": true
    },
    {
      "source": "/worksheets.html",
      "destination": "/worksheets",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
